<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Advanced Login System</title>
<link rel="stylesheet" href="style.css">
</head>
<body>

<div class="container">

    <div class="form-box" id="registerBox">
        <h2>Register</h2>
        <input type="text" id="regName" placeholder="Full Name">
        <input type="email" id="regEmail" placeholder="Email">
        <input type="password" id="regPassword" placeholder="Password">
        <div id="strength"></div>
        <button onclick="register()">Register</button>
        <p>Already have account? <span onclick="showLogin()">Login</span></p>
    </div>

    <div class="form-box hidden" id="loginBox">
        <h2>Login</h2>
        <input type="email" id="loginEmail" placeholder="Email">
        <input type="password" id="loginPassword" placeholder="Password">
        <button onclick="login()">Login</button>
        <p>Don't have account? <span onclick="showRegister()">Register</span></p>
    </div>

</div>

<script src="script.js"></script>
</body>
